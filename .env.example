# =============================================================================
# Compose-level variables for the single-box stack (docker-compose.yml).
#
# Copy to `.env` next to docker-compose.yml:  cp .env.example .env
# `.env` is gitignored (it holds a password); this example is not.
#
# The backend's OWN configuration lives in backend/.env.production, copied from
# backend/.env.production.example. Keep the two apart: this file configures the
# containers, that one configures the application (and is what the backend's
# production boot guard reads).
# =============================================================================

# Postgres credentials for the `postgres` service. POSTGRES_PASSWORD is REQUIRED
# — compose refuses to start without it rather than defaulting to something weak.
# Generate one:  openssl rand -base64 24
POSTGRES_USER=seti
POSTGRES_PASSWORD=
POSTGRES_DB=seti

# Host port for the API. It is ALWAYS published to 127.0.0.1, never 0.0.0.0.
#
# Leave this unset on the VM (defaults to 4000, where Cloudflare Tunnel expects
# it). Set it only to run the stack beside other services on the same machine,
# e.g. API_HOST_PORT=14000 when the dev server already holds 4000.
# API_HOST_PORT=4000

# Point the stack at a managed/external Postgres instead of the bundled one by
# setting this. It overrides DATABASE_URL for the api, indexer and migrate
# services. Leave it unset to use the `postgres` service on the compose network.
# SETI_DATABASE_URL=postgresql://user:pass@host:5432/seti?schema=public&sslmode=require

# Privy / Tempo Accounts (embedded wallets)
PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# Tempo network
# 4217 = mainnet, 42431 = testnet (Moderato)
TEMPO_CHAIN_ID=42431

# RPC provider. Set ALCHEMY_API_KEY to use Alchemy, or set TEMPO_RPC_URL to any RPC.
# TEMPO_RPC_URL takes precedence if both are set.
ALCHEMY_API_KEY=
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Tempo token contracts (must match TEMPO_CHAIN_ID)
#
# v1 supports pathUSD and OUSD only. These two are verified as deployed on
# BOTH Tempo mainnet (4217) and Moderato testnet (42431), decimals 6.
TEMPO_TOKEN_PATHUSD=0x20c0000000000000000000000000000000000000
TEMPO_TOKEN_OUSD=0x20c0000000000000000000006a37da5c996874be

# Mainnet safety gate. Set to "true" only when intentionally operating on mainnet.
ALLOW_MAINNET=false

# Address that collects the merchant fee. Must match backend/.env exactly.
SETI_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

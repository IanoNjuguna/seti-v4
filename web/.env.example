# Web app configuration. Copy to .env.local and fill in.
#
# These must agree with backend/.env — a mismatch means signing a
# transfer on the wrong chain or against the wrong token contract.

# The Seti API. Optional: defaults to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The app's canonical origin — the host the app is actually served from, with no
# path and no trailing slash. Optional: defaults to https://seti.live.
#
# It is the ONE source for absolute links the app hands out (see `lib/site.ts`):
# a sticker's QR, a shared merchant link, the hero's payment QR. It must NOT be
# left to `window.location` — the landing page is prerendered at build time,
# where there is no `window`, and a QR that encodes the host that happened to
# serve a preview build (`localhost:3100`, a worker preview) is printed on a
# sticker and cannot be corrected afterwards. Set this to the deployed origin.
NEXT_PUBLIC_SITE_ORIGIN=https://seti.live

# Privy app id for the browser. This is public (it ships in the client bundle).
# Two things must also be true for sign-in to work:
#   1. This app's origin is in the app's allowed origins in the Privy dashboard.
#   2. The backend has PRIVY_APP_ID and PRIVY_APP_SECRET for the SAME app, because
#      it verifies the token this app issues.
NEXT_PUBLIC_PRIVY_APP_ID=

# Tempo network. 42431 = Moderato testnet, 4217 = mainnet.
NEXT_PUBLIC_TEMPO_CHAIN_ID=42431

# TIP-20 token contracts for the configured chain. Both required.
NEXT_PUBLIC_TEMPO_TOKEN_PATHUSD=
NEXT_PUBLIC_TEMPO_TOKEN_OUSD=

# The primary asset the app signs and labels with — `ousd` or `pathusd`.
# Defaults to `ousd`, Seti's decided money path. One setting, read once in
# `lib/chain` and consumed by both signing hooks; must match the backend's
# TEMPO_ASSET.
NEXT_PUBLIC_TEMPO_ASSET=ousd

# Must be "true" to allow mainnet. Testnet is the default and is refused only if
# the chain id is mainnet without this flag.
#
# This is the browser's half of the served network: with NEXT_PUBLIC_TEMPO_CHAIN_ID
# it decides whether the build serves Live (`DEPLOYMENT_SERVES_MAINNET`), and the
# Profile Practice ⇄ Live control disables Live — with this deployment's real
# reason — when it does not. To serve Live it must agree with the backend: set
# NEXT_PUBLIC_TEMPO_CHAIN_ID=4217 AND NEXT_PUBLIC_ALLOW_MAINNET=true here, and have
# the backend serve mainnet too (TEMPO_CHAIN_ID=4217, or DEFAULT_NETWORK=mainnet
# with ALLOW_MAINNET=true).
NEXT_PUBLIC_ALLOW_MAINNET=false

{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/guard-production-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:build-env": "node scripts/guard-production-env.check.mjs",
    "check:ink": "node scripts/check-ink-contrast.mjs",
    "check:asset-split": "tsx scripts/check-asset-split.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/guard-production-env.mjs && vite build && npm run restore:route-types",
    "restore:route-types": "next typegen",
    "start:vinext": "vite preview",
    "preview:worker": "wrangler dev --config dist/server/wrangler.json --port 8787",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.48.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "react-server-dom-webpack": "^19.2.8",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.150.0"
  },
  "type": "module"
}

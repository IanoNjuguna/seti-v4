# Seti backup job — systemd EnvironmentFile for seti-backup.service.
#
# Install to /etc/seti/backup.env and chmod 640 (it holds a database password):
#   sudo cp deploy/backup/backup.env.example /etc/seti/backup.env
#   sudo chmod 640 /etc/seti/backup.env
#
# NOTHING here is a new application dependency. pg_dump/pg_restore come from
# postgresql-client and rclone is a single static binary the runbook installs;
# the backend itself never runs this.

# ---------------------------------------------------------------------------
# Where the database lives.
#
# MODE=docker — Postgres is the `postgres` service in docker-compose.yml and is
#   NOT published to the host (by design). The script reaches it with
#   `docker compose exec`. Use this for the compose deployment.
# MODE=host   — Postgres is installed on the box and reachable at localhost.
#   Use this for the systemd deployment; then DATABASE_URL is required too.
# ---------------------------------------------------------------------------
MODE=docker
COMPOSE_FILE=/opt/seti/docker-compose.yml
POSTGRES_USER=seti
POSTGRES_DB=seti

# Only needed for MODE=host:
# DATABASE_URL=postgresql://seti:REPLACE_ME@127.0.0.1:5432/seti?schema=public

# ---------------------------------------------------------------------------
# Where the backup goes. OFF-PROVIDER: Cloudflare R2, not Oracle Object Storage,
# so the copy survives losing the Oracle account.
#
# R2_REMOTE is the NAME of an rclone remote defined in ~seti/.config/rclone/rclone.conf
# (see rclone.conf.example). It is not a URL.
# ---------------------------------------------------------------------------
R2_REMOTE=r2
R2_BUCKET=seti-backups
R2_PATH=seti/postgres

# Keep 30 days of nightly archives off-provider.
RETENTION_DAYS=30

# zlib level for the custom-format dump (1-9). 9 is right for a small ledger.
COMPRESS_LEVEL=9

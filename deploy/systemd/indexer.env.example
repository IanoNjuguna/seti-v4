# Seti indexer — systemd EnvironmentFile for seti-indexer.service.
#
# Install to /etc/seti/indexer.env (chmod 640, group seti). Identical to
# /etc/seti/api.env EXCEPT INDEXER_ENABLED and HOST/PORT, which the worker does
# not use. Keep DATABASE_URL, TEMPO_CHAIN_ID, TEMPO_RPC_URL and the token
# addresses in step with the API's file — a cursor on one chain advancing while
# the API serves another produces unexplained rows.
#
#   sudo cp deploy/systemd/indexer.env.example /etc/seti/indexer.env
#   sudo chmod 640 /etc/seti/indexer.env

DATABASE_URL=postgresql://seti:REPLACE_ME@127.0.0.1:5432/seti?schema=public

NODE_ENV=production

JWT_SECRET=REPLACE_ME
QUOTE_SIGNING_SECRET=REPLACE_ME
PRIVY_APP_ID=REPLACE_ME
PRIVY_APP_SECRET=REPLACE_ME
DEV_BYPASS_AUTH=false

TEMPO_CHAIN_ID=42431
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_TOKEN_PATHUSD=0x20c0000000000000000000000000000000000000
TEMPO_TOKEN_OUSD=0x20c0000000000000000000006a37da5c996874be
TEMPO_ASSET=ousd
SETI_TREASURY_ADDRESS=0x48cb25f9d82aF721e71437feAfb295da627BA475
ALLOW_MAINNET=false
INDEXER_BOOTSTRAP_LOOKBACK=0
FEE_ROUTING_MODE=batch

# Required in production by the boot guard even though the worker serves no HTTP:
# the config module is loaded before anything runs.
CORS_ALLOWED_ORIGINS=https://app.seti.example

# This process IS the indexer.
INDEXER_ENABLED=true

QUOTE_TTL_SECONDS=60
MERCHANT_FEE_PERCENT=2
MERCHANT_FEE_MIN_KES=0
MERCHANT_FEE_MAX_PERCENT=0
STUCK_TX_AGE_MINUTES=10
STUCK_TX_SWEEP_LIMIT=25

# Seti API — systemd EnvironmentFile for seti-api.service.
#
# Install to /etc/seti/api.env and chmod 600 (it holds secrets):
#   sudo install -d -m 0750 -o root -g seti /etc/seti
#   sudo cp deploy/systemd/api.env.example /etc/seti/api.env
#   sudo chmod 640 /etc/seti/api.env
#
# This is the same surface as backend/.env.production (which the compose path
# uses) plus DATABASE_URL, which compose fills in automatically but systemd does
# not. Everything here is read at process start; with NODE_ENV=production the
# boot guard refuses to start on an insecure or incomplete set and names the
# offending variable(s) in the journal.

# --- Database ----------------------------------------------------------------
# Loopback only: the database is on this box and must never listen on a public
# interface. Password comes from ./.env (compose) or the Postgres install.
DATABASE_URL=postgresql://seti:REPLACE_ME@127.0.0.1:5432/seti?schema=public

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Loopback is enough: Cloudflare Tunnel reaches 127.0.0.1:4000 from inside the
# box, so the API never needs to listen on a public interface. Widen to 0.0.0.0
# only if you have deliberately decided to expose the port through the oracle's
# firewall instead of the tunnel.
HOST=127.0.0.1

# --- Secrets (openssl rand -base64 32) ---------------------------------------
JWT_SECRET=REPLACE_ME
QUOTE_SIGNING_SECRET=REPLACE_ME
PRIVY_APP_ID=REPLACE_ME
PRIVY_APP_SECRET=REPLACE_ME
DEV_BYPASS_AUTH=false

# --- Chain -------------------------------------------------------------------
TEMPO_CHAIN_ID=42431
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_TOKEN_PATHUSD=0x20c0000000000000000000000000000000000000
TEMPO_TOKEN_OUSD=0x20c0000000000000000000006a37da5c996874be
TEMPO_ASSET=ousd
SETI_TREASURY_ADDRESS=0x48cb25f9d82aF721e71437feAfb295da627BA475
ALLOW_MAINNET=false
INDEXER_BOOTSTRAP_LOOKBACK=0
FEE_ROUTING_MODE=batch

# --- Cross-origin policy (REQUIRED in production) ----------------------------
CORS_ALLOWED_ORIGINS=https://app.seti.example

# --- Indexer: this process must NOT run the loop -----------------------------
INDEXER_ENABLED=false

# --- Fee schedule / FX -------------------------------------------------------
QUOTE_TTL_SECONDS=60
MERCHANT_FEE_PERCENT=2
MERCHANT_FEE_MIN_KES=0
MERCHANT_FEE_MAX_PERCENT=0
STUCK_TX_AGE_MINUTES=10
STUCK_TX_SWEEP_LIMIT=25

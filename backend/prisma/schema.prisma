generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets      Wallet[]
  transactions Transaction[]

  @@map("users")
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String
  chain        String // "tempo"
  asset        String // "ousd", "usdc.e", etc.
  address      String        @unique
  encryptedKey String? // ref to KMS/HSM; never the raw key
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, asset])
  @@map("wallets")
}

model Merchant {
  id            String   @id @default(cuid())
  name          String
  category      String?
  bankAccount   String? // encrypted settlement account
  bankName      String?
  bankCurrency  String? // "KES"
  payoutAddress String? // on-chain settlement address
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]

  @@map("merchants")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  walletId      String
  type          TransactionType
  status        TransactionStatus @default(pending)
  amount        Decimal           @db.Decimal(24, 8)
  asset         String // "ousd"
  fiatAmount    Decimal?          @db.Decimal(24, 8)
  fiatCurrency  String? // "KES"
  merchantId    String?
  counterparty  String? // wallet address, phone, or merchant id
  description   String?
  metadata      Json? // qr payload, bridge/stripe refs, on-chain tx hash
  settledAt     DateTime?
  failedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  wallet   Wallet    @relation(fields: [walletId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("transactions")
}

enum TransactionType {
  payment
  p2p_send
  p2p_receive
  top_up
  withdrawal
  fee
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  reversed
}

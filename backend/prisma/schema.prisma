generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  /// The entry key at LOGIN (`POST /auth/verify` upserts on it) and a label on
  /// the account — but NOT the key a live session resolves by. See `privyDid`.
  email         String     @unique
  phone         String?    @unique
  /// The Privy DID (`did:privy:…`) this account was ESTABLISHED with.
  ///
  /// The immutable subject of every Privy token for this user, written once at
  /// `POST /auth/verify` — the moment a session is established. `middleware/auth.ts`
  /// resolves the caller by THIS, never by re-reading the email Privy reports at
  /// request time: an email is a mutable attribute, so keying a live session on it
  /// means a later change re-points — or kills — a session that was established for
  /// a different identity, and the recorded history of the old session then appears
  /// to belong to whoever holds that email now.
  ///
  /// NULL for accounts that predate this column and for the dev bypass user, which
  /// has no Privy identity. Such a session simply cannot resolve by subject and
  /// re-authenticates once through `/auth/verify`, which binds it.
  privyDid      String?    @unique
  firstName     String?
  lastName      String?
  kycStatus     KycStatus  @default(none)
  kycTier       KycTier    @default(tier_0)
  dailyVolume   Decimal    @default(0) @db.Decimal(24, 8)
  monthlyVolume Decimal    @default(0) @db.Decimal(24, 8)
  /// The customer's money is denominated in this. ISO 4217. KES in v1; the
  /// backend refuses to price in a currency the app no longer enables, so a
  /// stored code outliving its configuration cannot produce unexplained figures.
  fiatCurrency  String     @default("KES")
  /// Which mode the app presents this account in: `personal` or `business`.
  ///
  /// NOT an onboarding flag. Whether onboarding is FINISHED is derived from data
  /// that already exists — the presence of a `Handle` row for this user — so
  /// there is no `onboardedAt` to go stale or to disagree with the handles. This
  /// column only answers a question the handles cannot: with a username AND a
  /// business name both claimed (which the model allows, and which "try it as a
  /// person, add a business later" requires), which of the two the account is
  /// currently acting as. Deriving it instead would make `business` win forever
  /// the moment a business name exists — a one-way door where the feature needs
  /// a reversible one. It never gates anything: a user with this column set and
  /// no handle is still, correctly, not onboarded.
  intent        String     @default("personal")
  /// Which NETWORK the account is acting on: `testnet` (Practice) or `mainnet`
  /// (Live). A per-account PREFERENCE, server-decided and stored — never taken
  /// from a client. Switching to `mainnet` is refused with a stated reason until
  /// the deployment is mainnet-ready (`config/networks.ts`), and on the switch
  /// the account's existing handles receive FIRST REFUSAL on the live network.
  ///
  /// Rows (Wallet, Handle, Transaction) carry their OWN network; this column only
  /// answers which network the account is ACTING on right now, the way `intent`
  /// answers which mode. It is a session property: a request is served under it,
  /// so a client-supplied chain id has nothing to override.
  network       String     @default("testnet")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallets      Wallet[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  handles      Handle[]
  /// Invites this account handed out (see `Referral`): ONE row per attributed
  /// invitee, written at sign-up.
  referralsMade     Referral[] @relation("ReferralsMade")
  /// The invite this account ARRIVED on, if any. At most one, because
  /// `Referral.invitedUserId` is unique.
  referralReceived  Referral?  @relation("ReferralsReceived")

  @@map("users")
}

model Wallet {
  id        String       @id @default(cuid())
  userId    String
  chain     String // "tempo"
  asset     String // "ousd", "usdc.e", etc.
  address   String
  /// The network this wallet belongs to: `testnet` (Practice) or `mainnet`
  /// (Live). A wallet row is an address ON A NETWORK — the same key can be
  /// registered for practice and for live, and a live deposit address is usually
  /// a DIFFERENT key, funded from another wallet. Every uniqueness rule on this
  /// table is scoped by it.
  network   String       @default("testnet")
  status    WalletStatus @default(active)
  keyId     String? // opaque reference to KMS/HSM key; never the raw key
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  // One ACTIVE wallet per (userId, asset, network) is enforced by a PARTIAL
  // unique index (`wallets_userId_asset_<network>_active_key`), created in
  // migration 20261014090000_network_scope. It is deliberately NOT expressed
  // here: Prisma's schema cannot model `WHERE status = 'active'`, and the index
  // it replaces — `@@unique([userId, asset, status])` — COUNTED the deprecated
  // row, so deprecating the current active row on rotation collided with the
  // deprecated row a previous rotation had left behind. Deprecated rows are
  // history and must be unbounded; only the ACTIVE row is capped.
  //
  // The SAME rule is now scoped by `network`: one active row per asset PER
  // NETWORK, so an account can hold a practice wallet and a live wallet at once.
  // `address` is also unique PER NETWORK (a partial unique index, one per
  // network), NOT globally — the same key may be registered for practice and for
  // live, and the same address on two chains is two rows.
  @@index([userId, status])
  @@index([network, userId, status])
  @@map("wallets")
}

/// THE namespace. One row per handle, whether it belongs to a person or a
/// business — a person's username and a business's name are the same kind of
/// signed handle and compete for the same string. "Person or business" is a
/// PROFILE MODE (`kind`) on one handle, never a different identity: there is one
/// lookup box, one claim, and one resolver.
///
/// A handle belongs to an ADDRESS, and a merchant profile is a mode on top of it
/// (`merchantId`), which is why the claim lives here rather than on the Merchant
/// row. The binding is an EIP-712 signature, stored verbatim and RE-VERIFIED from
/// the stored signature on every read — there is no stored "verified" boolean. A
/// compromised database can at worst HIDE a handle; it cannot invent a binding,
/// because a binding is a signature and forging one is not a database write.
///
/// The signature is PURPOSE-SCOPED (`purpose`): a signature made to claim a
/// username cannot be replayed to claim a merchant name, or the reverse.
model Handle {
  id             String    @id @default(cuid())
  /// The ONE namespace key — lowercased, `[a-z0-9._-]`.
  ///
  /// Uniqueness is TWO rules, and which applies depends on `kind`:
  ///
  ///  - `kind = 'person'` — GLOBAL, across every network. A person's username is
  ///    one name for one account on both Practice and Live, so a DIFFERENT account
  ///    cannot take it on the other network (impersonation in the exact surface
  ///    where the name is the trust signal). Enforced by the partial unique index
  ///    `handles_person_handle_key`, created in migration
  ///    `20261014140000_global_person_handles` — Prisma cannot express `WHERE`, so
  ///    it is not declared here.
  ///  - `kind = 'business'` — PER NETWORK (`handles_handle_<network>_key`, from
  ///    migration 20261014090000_network_scope), and every kind still collides
  ///    WITHIN one network.
  ///
  /// WHY A BUSINESS NAME STAYS PER NETWORK (the owner's ruling, 2026-10-14): when
  /// KYB lands, the real merchant carries a VERIFIED MARK, so a squatter holding
  /// `kfc` is visually distinguishable from the real one on the page a customer
  /// pays from. The namespace is not the trust mechanism for a business — the
  /// verification badge is. So the string may legitimately exist twice, once per
  /// network, while a person's name must not. Do not "fix" this by making business
  /// handles global: that would take a practice merchant's name away on live and
  /// decide a question the owner has deliberately left open (what a practice
  /// business name should mean on live).
  ///
  /// Computed by `handleOf` in `lib/merchant-name.ts`, which the web mirrors in
  /// `lib/merchant-link.ts`. STORED and UNIQUE because the rule DROPS characters:
  /// `Mama's Grill` and `Mamas Grill` are two distinct NAMES that reduce to one
  /// handle, and only a stored unique column makes `seti.live/<x>/<handle>`
  /// unambiguous about who is paid.
  handle         String
  /// `testnet` | `mainnet` — the network this claim is BOUND on.
  ///
  /// For a BUSINESS handle that is its scope: it resolves there and nowhere else.
  /// For a PERSON handle it is PROVENANCE, not scope: the signature was made for
  /// that network's EIP-712 domain, and the name itself is global (see `handle`
  /// above) — it resolves and is honoured on both networks.
  network        String    @default("testnet")
  /// `person` | `business` — a profile mode on the handle, not an identity.
  kind           String    @default("business")
  /// The username a person typed, or a business's name. Same rule for both.
  name           String
  /// The EIP-712 purpose this binding was signed with: `username` or
  /// `merchant-name`. NULL only for a handle backfilled from a merchant claim
  /// made BEFORE `purpose` existed — its signature was made without the field,
  /// so it is re-verified against the legacy message shape. Every handle claimed
  /// through the API stores a purpose, which is what makes a replay across
  /// purposes impossible.
  purpose        String?
  /// The address the handle is bound to. The authoritative thing for the money
  /// path: a name is only ever a label beside it.
  address        String
  /// The signature, stored verbatim — this is the whole point of the feature.
  claimSignature String?
  /// The `issuedAt` EXACTLY as it appeared in the signed message. Kept as the raw
  /// string, not a DateTime: re-deriving an ISO string from a timestamp can differ
  /// by precision or offset, and a genuine signature would then fail to re-verify.
  claimIssuedAt  String?
  claimNonce     String?
  /// When the backend accepted the claim. Distinct from `claimIssuedAt`.
  claimedAt      DateTime?
  /// The account the handle belongs to. Informational, not a trust anchor: what
  /// makes a claim true is the signature, never who posted it.
  ///
  /// ONE PERSON NAME PER ACCOUNT, structurally: a partial unique index
  /// `handles_person_user_key` on `("userId") WHERE kind = 'person' AND "userId"
  /// IS NOT NULL` (migration `20261022200000_person_name_and_rename`) means an
  /// account holds at most one `kind = 'person'` row. Two names for one person is
  /// an impersonation surface — both resolve, each to whatever address it was
  /// bound to — and it makes an invite link ambiguous about which name is really
  /// that person. Business handles are deliberately NOT capped: a merchant may
  /// legitimately run more than one name, and a business's uniqueness is its
  /// network's namespace, not its account.
  ///
  /// The managed way to change that one name is a RENAME (`claimHandle` with
  /// `rename: true`): the new string is written and the old one moves to
  /// `HandleRelease` with `reason = 'renamed'`, where it keeps resolving to this
  /// account for 30 days before it frees. A second person claim WITHOUT the
  /// rename is refused (`rename-required`); it never silently becomes a rename,
  /// because a rename drops a public name and that is not something to infer from
  /// a payload.
  userId         String?
  /// The business profile, when `kind = 'business'`. A person has none.
  merchantId     String?   @unique
  /// Brand-review state: NULL for a normal handle, `pending` for a claim whose
  /// name matched a HELD BRAND (see `lib/held-brands.ts`), and `reserved` for a
  /// live-side hold that gives the SAME ACCOUNT first refusal on a name it already
  /// holds while practising.
  ///
  /// Deliberately a second, SEPARATE state from verification. `verified` is
  /// recomputed from the signature on every read and is not stored; this column
  /// stores the one thing the signature cannot say — whether a person has looked
  /// yet. A parked row KEEPS its string (the unique index is untouched), but the
  /// resolvers filter it out, so it is not public, has no page and no QR, and a
  /// payer who resolves it gets a name that does not exist. It never reads as
  /// verified while parked. Refusing a parked claim deletes the row, freeing the
  /// string; the reason is recorded in `audit_logs` (`handle.brand.refused`).
  ///
  /// `reserved` is the same kind of invisible hold, for a different reason: on the
  /// switch to live, a name the account holds while practising is written on the
  /// live network SOLELY to hold its string for that account (no signature yet, so
  /// it does not verify and does not resolve). A live claim of that string by
  /// ANOTHER account is `handle-taken`; the holding account re-claims it with a
  /// fresh live signature, which is what makes it live.
  reviewStatus   String?
  /// The held brand the name matched, as spelled on the list — so a parked row
  /// can name, later, what the claimer has to send. Informational.
  reviewBrand    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([userId])
  @@index([handle])
  @@index([name])
  @@index([network, handle])
  /// The reviewer's queue: every parked claim (`reviewStatus = 'pending'`).
  @@index([reviewStatus])
  @@map("handles")
}

/// A claim that was RELEASED — because a proved brand took the name, or because
/// its owner RENAMED away from it.
///
/// A brand proving ownership must be able to take a name whatever state it is in
/// — including one already claimed by someone else. The handle string is unique,
/// so the previous claimer's row must go for the new one to exist; this table is
/// where it goes. It is a full copy of the released claim (the signature and all)
/// plus WHY it was released, so a reassignment is never a silent overwrite and the
/// previous holder's record survives.
///
/// It is ALSO where a renamed string's 30-day hold lives. A rename moves the old
/// string here with `reason = 'renamed'` and no recipient, and for those 30 days
/// the release row is what `findHandleByHandle` resolves the old string FROM — so
/// `seti.live/u/<old>`, a printed QR and every shared link keep pointing at the
/// account that renamed, instead of 404ing on the day of the rename. Holding the
/// string rather than freeing it is the whole point: freeing it either breaks
/// every link that was shared or hands the name to whoever asks next.
///
/// The vocabulary of `reason` is load-bearing, not prose:
///  - `'renamed'` — a live name the owner moved off; the string is HELD to that
///    account for 30 days (`RENAME_HOLD_DAYS`) and nobody else can claim it.
///  - `'renamed-unlive'` — a name that never resolved (a row with no signature,
///    such as a `reserved` first-refusal hold). Nothing was in use, so nothing is
///    held: a hold would make an unpublished name resolvable.
///  - anything else — a brand reassignment or a migration, with
///    `reassignedTo` set or not. No hold is ever read from these.
///
/// Deliberately NOT related by foreign key to `User`/`Merchant`: this is a
/// historical record that must outlive any account or profile deletion, so it
/// keeps the ids as plain strings rather than following them.
model HandleRelease {
  id             String   @id @default(cuid())
  /// The string that was reassigned, e.g. `kfckaribu` — the link a customer had.
  handle         String
  /// The name the RELEASED claim was made under.
  name           String
  /// The kind it was claimed as (`person` | `business`).
  kind           String
  /// The address the released claim pointed at.
  address        String
  /// The EIP-712 purpose the released claim was signed for. Recorded from
  /// migration `20261022200000_person_name_and_rename` onward, because a held
  /// string has to re-verify from its release row and the signature covers the
  /// purpose. NULL on rows written before it (a legacy backfilled claim has no
  /// purpose either).
  purpose        String?
  /// The network the released claim was BOUND on (`testnet` | `mainnet`) — the
  /// EIP-712 domain its signature was made against. Without it a held string
  /// could not be re-verified on the chain id it was signed for. NULL on rows
  /// written before the migration above; verification then falls back to the
  /// served network.
  network        String?
  claimSignature String?
  claimIssuedAt  String?
  claimNonce     String?
  /// The account that held the released claim, if any. For a `'renamed'` row this
  /// is the account the old string still resolves TO during the hold, and the only
  /// account allowed to claim it back inside the window.
  userId         String?
  /// The business profile the released claim turned on, if any.
  merchantId     String?
  /// Why it was released — a reviewer's reason, `'renamed'`, or a migration's.
  reason         String
  /// The address it was reassigned TO (the brand's, proved by signature).
  ///
  /// NULL when the string went to NOBODY: a rename (the owner moved off it and
  /// holds it), or a duplicate person name resolved by migration
  /// `20261022200000_person_name_and_rename`. Nullable since that migration, which
  /// also seeded the existing rows' column comment.
  reassignedTo   String?
  createdAt      DateTime @default(now())

  @@index([handle])
  @@map("handle_releases")
}

/// A business PROFILE — the mode a business handle turns on. It carries what a
/// business is (a category, settlement details) and where its money goes
/// (`payoutAddress`), but NOT the claim: the handle, its signature and its
/// uniqueness live in `Handle`, so one string can only ever be one thing.
model Merchant {
  id            String   @id @default(cuid())
  name          String
  category      String?
  /// When a person at Seti reviewed this merchant, or NULL — the stored attribute the
  /// public pay page's verified tier requires (#154).
  ///
  /// STORED, never derived: not from volume, age, a category, a memo or the amount,
  /// because a payer reads it as "Seti looked at this business". NULL means nobody has,
  /// which is every merchant today, so the pay page's unverified tier is also the
  /// rollback state.
  ///
  /// A DIFFERENT FACT from a handle's `verified`, which is recomputed from the claim
  /// signature on every read. That one proves an address controls a name; this one proves
  /// a person looked at the business. The pay page needs both: a name with no reviewed
  /// merchant behind it is a name, not a verified merchant, and a reviewed merchant whose
  /// claim no longer verifies is not bound to the address the money would go to.
  verifiedAt    DateTime?
  /// What earned it: the case, reference or document the reviewer worked from.
  ///
  /// Required whenever `verifiedAt` is set, enforced by the CHECK in migration
  /// `20261023120000_merchant_verification` — Prisma cannot express a CHECK, so it is not
  /// declared here. Never rendered: it is the audit trail behind a badge, not a claim a
  /// payer reads.
  verifiedEvidence String?
  bankAccount   String? // encrypted settlement account
  bankName      String?
  bankCurrency  String? // "KES"
  payoutAddress String? // on-chain settlement address
  bridgeRecipientId String? // Bridge recipient ID for fiat payout
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]
  handleEntry  Handle?

  @@map("merchants")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  walletId      String
  /// The network this movement happened on: `testnet` (Practice) or `mainnet`
  /// (Live). Activity is scoped by it, so a practice top-up can never appear
  /// beside a live payment — and, because `txHash` uniqueness is scoped by it
  /// too, the same transaction hash on two chains is two rows rather than a
  /// collision.
  network       String            @default("testnet")
  type          TransactionType
  status        TransactionStatus @default(pending)
  amount        Decimal           @db.Decimal(24, 8)
  asset         String // "ousd"
  fiatAmount    Decimal?          @db.Decimal(24, 8)
  fiatCurrency  String? // "KES"
  // Merchant fee charged on this payment, in fiatCurrency. Null for
  // consumer-paid types where no merchant fee applies (p2p, top-up).
  feeAmount     Decimal?          @db.Decimal(24, 8)
  // Fee before the max-percent cap was applied. Kept so a capped fee can be
  // reconciled against the published schedule after the fact.
  feeUncappedAmount Decimal?       @db.Decimal(24, 8)
  // True when feeAmount was limited by MERCHANT_FEE_MAX_PERCENT rather than
  // by the published schedule.
  feeCapped     Boolean           @default(false)
  // What the merchant actually receives: fiatAmount - feeAmount. Stored rather
  // than recomputed from a rate that may since have moved.
  //
  // Future-shape, not a payout path: no off-ramp exists in v1 (prd.md §7). The
  // bank/bridge columns on Merchant and the `offramp.*` audit actions are the
  // same category — documented intent, zero call sites.
  merchantNetAmount Decimal?      @db.Decimal(24, 8)
  // FX rate used to derive the fiat figures, and where it came from. Stored so
  // a historical row can always be explained.
  fxRate        Decimal?          @db.Decimal(24, 8)
  fxRateSource  String? // "open.er-api.com", "fallback", etc.
  fxRateAsOf    DateTime?
  merchantId    String?
  counterparty  String? // wallet address, phone, or merchant id
  txHash        String? // on-chain transaction hash — unique PER USER, see below
  blockNumber   BigInt?
  description   String?
  metadata      Json? // qr payload, bridge/stripe refs
  settledAt     DateTime?
  failedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  wallet   Wallet    @relation(fields: [walletId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  /// Activity is read per network, newest first.
  @@index([network, userId, createdAt])
  // One row per user per on-chain transfer PER NETWORK.
  //
  // `txHash` alone used to be unique, which meant one transfer could only ever have
  // ONE ledger row — written by whoever recorded it first, always the sender. A
  // transfer between two Seti accounts is one transaction and two movements of
  // money, and the recipient's side had nowhere to go. Scoping the uniqueness to
  // the user lets both sides exist while still refusing to record the same transfer
  // twice for one account.
  //
  // Scoping it ALSO by network is what keeps practice and live apart: the same hash
  // can legitimately exist on two chains, and without the network in the key the
  // second chain's row would collide with the first's — cross-contaminating two
  // ledgers that must never mix.
  @@unique([txHash, userId, network])
  @@map("transactions")
}

/// A CHARGE: a signed request for money, made by someone with no Seti account.
///
/// The recipient's wallet signs `{recipient, asset, amount, memo, id, expiresAt,
/// nonce}` and that signature IS the account — there is no user id here on
/// purpose, and no foreign key to one. `services/charge.ts` owns the object, the
/// canonical payload and the classifier; this table is only where a charge is
/// KEPT between the request that created it and the transfer that settles it.
///
/// Two ids, and the difference matters:
///
///  - `publicId` is the MINTED id — chosen by the recipient, signed by them, the
///    string in the URL, the QR and the transfer's 32-byte memo. It is what a
///    payer holds, so it must be unique per recipient (the same string for two
///    different payees is two charges, and a link names one payee).
///  - `id` is this table's own cuid, used by the delivery log's foreign key.
///    Nothing outside the database ever sees it.
///
/// `amount`, `received` and `memo` are decimal/base strings, never numbers: the
/// ledger stores decimal strings and a float is how an amount becomes a cent
/// wrong (see `docs/internal/charge-object.md`).
model Charge {
  id              String        @id @default(cuid())
  /// The recipient-signed id: `^[a-z0-9][a-z0-9_-]{5,63}$`, lower-case by rule
  /// (`services/charge-store.ts` `CHARGE_ID_PATTERN`; the web mirrors it).
  publicId        String
  /// The payee. Lower-cased at write time so a match never depends on casing.
  recipient       String
  /// The Seti ledger label (`ousd`), not a token address — the chain is `chainId`.
  asset           String
  /// What is owed, decimal token units (`"250.000000"`). Signed.
  amount          String
  /// Payer-visible text, and the field that CARRIES `publicId` for matching. Signed.
  memo            String
  /// `expiresAt` EXACTLY as signed, kept as the raw string: a stored DateTime
  /// re-rendered as ISO can differ by precision or offset, and the signature
  /// would then never verify again. The same rule `Handle.claimIssuedAt` follows.
  expiresAtRaw    String
  /// The same instant, as a timestamp — so an expiry sweep is one index scan
  /// rather than a string comparison over every pending row.
  expiresAt       DateTime
  nonce           String
  /// Reserved and UNSIGNED in v1 (see `docs/internal/charge-object.md`).
  scope           String?
  /// EIP-712 signature by `recipient`, stored verbatim and re-verified from the
  /// stored bytes on every read. There is no stored `verified` flag: a
  /// compromised database can at worst hide a charge, it cannot invent one.
  signature       String
  status          ChargeStatus  @default(pending)
  /// The network the signature was made under. A charge is signed with the chain
  /// id in its domain, so it is a PRACTICE charge or a LIVE one and can never be
  /// replayed across the two.
  network         String        @default("testnet")
  chainId         Int
  /// The transfer that decided this charge, once one has. Never signed, never
  /// authority — the on-chain receipt is.
  txHash          String?
  /// How much actually arrived, decimal token units (`"0.000000"` until one does).
  /// Stored rather than recomputed: the transfer is the fact.
  received        String        @default("0.000000")
  /// Whether the 2% reached the treasury in this charge's receipt, decided by
  /// `classifyFeeLeg` from the SAME transaction that settled the charge.
  ///
  /// NULL means "not decided" — a pending charge, a cancel, or a row written
  /// before this column existed. It is never inferred from `status`: a `paid`
  /// charge whose fee leg was missing is `paid` with this false, and that pair is
  /// the truth the column exists to make visible.
  feeCollected    Boolean?
  /// Why not, when it was not: a `ChargeFeeReason` code, never prose.
  feeUncollectedReason String?
  /// When the status last moved to a terminal state (paid/underpaid/overpaid/expired).
  settledAt       DateTime?
  /// When the RECIPIENT cancelled it. Cancelling moves the charge to `expired`
  /// (the frozen v1 enum has no `cancelled` state) and this column is what tells
  /// the two expiries apart — a deliberate end versus a lapsed deadline.
  cancelledAt     DateTime?
  /// Where to deliver webhooks for this charge. Declared at create time and never
  /// updated, because there is no update route. NOT part of the signature in v1
  /// (the signed set is frozen); see the open question in `docs/internal/charge-api.md`.
  webhookUrl      String?
  /// Idempotency: the key's HASH, never the key, plus the exact response body that
  /// was returned for it. A replay returns `responseBody` byte for byte rather
  /// than re-deriving it, so "the same key returns the original" is true even
  /// after the charge has since moved status.
  idempotencyKey  String?
  idempotencyAt   DateTime?
  /// The exact JSON body a create returned, as TEXT.
  ///
  /// Text rather than `Json` on purpose: Postgres `jsonb` does not preserve key order,
  /// so a replay from a `Json` column would answer the same VALUES in a different
  /// order. "The same `Idempotency-Key` returns the original body" is a promise about
  /// bytes a client may hash or diff, so the bytes are kept as they were sent.
  responseBody    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  deliveries ChargeWebhookDelivery[]

  /// One charge per id PER RECIPIENT — the same string for a different payee is a
  /// different charge, because a link names one payee and the id is signed.
  @@unique([recipient, publicId])
  /// One charge per idempotency key per recipient. Postgres treats NULLs as
  /// distinct, so charges created without the header do not collide here.
  @@unique([recipient, idempotencyKey])
  /// A read by id does not know the recipient, so this is the lookup index.
  @@index([publicId])
  /// The matcher's query: pending charges for one recipient on one asset.
  @@index([status, recipient, asset])
  /// The expiry sweep's query.
  @@index([status, expiresAt])
  /// The per-address create rate limit, and a merchant's own recent charges.
  @@index([recipient, createdAt])
  @@map("charges")
}

/// One webhook delivery, one row per STATUS CHANGE — never one per attempt.
///
/// The unique key `(chargeId, status)` is the exactly-once guarantee, expressed
/// where it cannot be bypassed: a transition that runs twice (a replayed transfer,
/// two indexer replicas, a retried request) collides on INSERT and the second
/// attempt reads the existing row instead of counting a second delivery. Attempts
/// and their backoff live as COLUMNS on this row, so the delivery log a recipient
/// reads says "delivered after 3 attempts" rather than growing three rows.
model ChargeWebhookDelivery {
  id             String   @id @default(cuid())
  chargeId       String
  /// The event name a receiver switches on: `charge.paid`, `charge.underpaid`,
  /// `charge.expired`. `overpaid` is delivered as `charge.paid` — money arrived at
  /// or above the ask — with `status: "overpaid"` in the body.
  event          String
  /// The status this delivery announces. HALF the dedupe key; the other half is
  /// the charge.
  status         ChargeStatus
  /// The URL as it was at delivery time: a charge's endpoint never changes, but a
  /// log row should say where the bytes were sent, not where they would go now.
  url            String
  /// `pending` (awaiting a retry), `delivered` (2xx), `failed` (no secret, or
  /// attempts exhausted).
  state          String   @default("pending")
  attempts       Int      @default(0)
  lastStatusCode Int?
  /// The last transport failure or non-2xx reason, in one line. Never a stack.
  lastError      String?
  /// When the next attempt is due. NULL for a delivered or failed row.
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  /// The exact JSON body that was (or would be) sent, so a delivery can be
  /// verified byte for byte after the fact — the signature covers these bytes.
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  /// EXACTLY ONE delivery per status change. The whole "a replay must not
  /// double-count" rule is this line.
  @@unique([chargeId, status])
  /// The retry sweep: due rows, oldest first.
  @@index([state, nextAttemptAt])
  @@map("charge_webhook_deliveries")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  /// On-chain transaction hash this event concerns, when there is one.
  ///
  /// Promoted out of `metadata` into a real column: support is handed a hash
  /// and needs every event about it, and the same hash is the only handle that
  /// exists for a payment that was refused before any row was written.
  txHash    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([txHash])
  @@map("audit_logs")
}

enum TransactionType {
  payment
  p2p_send
  p2p_receive
  top_up
  withdrawal
  fee
  /// One stablecoin exchanged for another against the DEX. No counterparty: the
  /// money went to a contract and came back as a different token, so the row's
  /// `amount`/`asset` are what ARRIVED and the input leg rides in `metadata`.
  convert
  /// Money moved INTO a savings vault. The row's `amount` is what reached the
  /// vault and `metadata.savings` carries the shares minted, the vault address and
  /// the swap leg — one row for one customer action, even though the transaction
  /// carries three calls.
  savings_deposit
  /// Money brought back OUT of the vault. `amount` is what arrived back in the
  /// spendable asset after the swap home.
  savings_withdrawal
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  reversed
}

enum WalletStatus {
  active
  frozen
  deprecated
}

/// Where a charge is. Mirrors `CHARGE_STATUSES` in `services/charge.ts` — the enum
/// exists so the database refuses a status the classifier could not produce, and
/// the module is still the single definition every surface renders.
///
/// No `cancelled`: a recipient's cancel moves the charge to `expired` (v1's enum is
/// frozen and a page already renders `expired`), and `Charge.cancelledAt` is what
/// distinguishes a deliberate end from a lapsed deadline.
enum ChargeStatus {
  pending
  paid
  underpaid
  overpaid
  expired
}

enum KycStatus {
  none
  pending
  verified
  rejected
}

enum KycTier {
  tier_0
  tier_1
  tier_2
}

/// Durable indexer progress, ONE ROW PER NETWORK (keyed by the network's chain
/// name, e.g. "tempo-testnet").
///
/// The cursor lives in Postgres rather than process memory so that a restart
/// resumes where it left off instead of re-scanning, and so that two backend
/// replicas cannot both advance the same cursor independently.
///
/// Per-network is what keeps practice and live apart: testnet's progress is not
/// mainnet's, so the two cursors advance INDEPENDENTLY and neither can drag the
/// other forward or backwards.
model IndexerCursor {
  /// Chain name, e.g. "tempo-testnet". Part of the primary key: switching
  /// networks gets its own cursor rather than inheriting an incompatible one.
  chain      String   @id
  /// Highest block whose logs have been fully processed.
  lastBlock  BigInt   @default(0)
  /// Identifies the replica currently scanning. Empty when idle.
  lockedBy   String?
  /// When lockedBy last acquired the lock. Used to reclaim a lock abandoned
  /// by a crashed replica.
  lockedAt   DateTime?
  updatedAt  DateTime @updatedAt

  @@map("indexer_cursors")
}

/// Who invited whom — one row per attributed invitee, written once.
///
/// The row is written at `POST /auth/verify` when an account is ESTABLISHED, never
/// when a link is opened: an open is a visit, and a visit is not a person. It is
/// only written for a NEW account (`services/signup.ts` returns `created`), so a
/// returning customer who once opened someone's link is never counted.
///
/// `invitedUserId` is UNIQUE, which is the whole of the "one attribution per
/// person" rule: a second invite link, a replayed code, or a second sign-up on the
/// same account all collide on this index instead of writing a second row. The
/// database enforces it rather than a read-then-write in the service, because two
/// concurrent sign-ups would both have read "no row yet".
///
/// `referrerId` is the AUTHORITY and `referrerHandle` is a SNAPSHOT taken when the
/// row was written. The cookie carries the id and never the handle, because a
/// handle can be parked or later released and given to a brand: re-resolving it at
/// attribution time would credit whoever holds the string then. The snapshot keeps
/// the words the invitee actually saw ("ian invited you") even after a rename, and
/// nothing reads it to route money or to re-resolve anything.
model Referral {
  id             String   @id @default(cuid())
  /// The account credited with the invite. Never a handle, never an email.
  referrerId     String
  /// The account that arrived. UNIQUE: one attribution per person, enforced here.
  invitedUserId  String   @unique
  /// The referrer's handle as the link named it, frozen at write time.
  referrerHandle String
  createdAt      DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  invited  User @relation("ReferralsReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)

  /// The invite screen's one read: this account's invitees, newest first.
  @@index([referrerId, createdAt])
  @@map("referrals")
}

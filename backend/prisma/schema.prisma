generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  /// The entry key at LOGIN (`POST /auth/verify` upserts on it) and a label on
  /// the account — but NOT the key a live session resolves by. See `privyDid`.
  email         String     @unique
  phone         String?    @unique
  /// The Privy DID (`did:privy:…`) this account was ESTABLISHED with.
  ///
  /// The immutable subject of every Privy token for this user, written once at
  /// `POST /auth/verify` — the moment a session is established. `middleware/auth.ts`
  /// resolves the caller by THIS, never by re-reading the email Privy reports at
  /// request time: an email is a mutable attribute, so keying a live session on it
  /// means a later change re-points — or kills — a session that was established for
  /// a different identity, and the recorded history of the old session then appears
  /// to belong to whoever holds that email now.
  ///
  /// NULL for accounts that predate this column and for the dev bypass user, which
  /// has no Privy identity. Such a session simply cannot resolve by subject and
  /// re-authenticates once through `/auth/verify`, which binds it.
  privyDid      String?    @unique
  firstName     String?
  lastName      String?
  kycStatus     KycStatus  @default(none)
  kycTier       KycTier    @default(tier_0)
  dailyVolume   Decimal    @default(0) @db.Decimal(24, 8)
  monthlyVolume Decimal    @default(0) @db.Decimal(24, 8)
  /// The customer's money is denominated in this. ISO 4217. KES in v1; the
  /// backend refuses to price in a currency the app no longer enables, so a
  /// stored code outliving its configuration cannot produce unexplained figures.
  fiatCurrency  String     @default("KES")
  /// Which mode the app presents this account in: `personal` or `business`.
  ///
  /// NOT an onboarding flag. Whether onboarding is FINISHED is derived from data
  /// that already exists — the presence of a `Handle` row for this user — so
  /// there is no `onboardedAt` to go stale or to disagree with the handles. This
  /// column only answers a question the handles cannot: with a username AND a
  /// business name both claimed (which the model allows, and which "try it as a
  /// person, add a business later" requires), which of the two the account is
  /// currently acting as. Deriving it instead would make `business` win forever
  /// the moment a business name exists — a one-way door where the feature needs
  /// a reversible one. It never gates anything: a user with this column set and
  /// no handle is still, correctly, not onboarded.
  intent        String     @default("personal")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallets      Wallet[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  handles      Handle[]

  @@map("users")
}

model Wallet {
  id        String       @id @default(cuid())
  userId    String
  chain     String // "tempo"
  asset     String // "ousd", "usdc.e", etc.
  address   String
  status    WalletStatus @default(active)
  keyId     String? // opaque reference to KMS/HSM key; never the raw key
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  // One ACTIVE wallet per (userId, asset) is enforced by a PARTIAL unique index
  // (`wallets_userId_asset_active_key`), created in migration
  // 20261013210000_wallet_one_active_per_asset. It is deliberately NOT expressed
  // here: Prisma's schema cannot model `WHERE status = 'active'`, and the index
  // it replaces — `@@unique([userId, asset, status])` — COUNTED the deprecated
  // row, so deprecating the current active row on rotation collided with the
  // deprecated row a previous rotation had left behind. Deprecated rows are
  // history and must be unbounded; only the ACTIVE row is capped.
  @@unique([address])
  @@index([userId, status])
  @@map("wallets")
}

/// THE namespace. One row per handle, whether it belongs to a person or a
/// business — a person's username and a business's name are the same kind of
/// signed handle and compete for the same string. "Person or business" is a
/// PROFILE MODE (`kind`) on one handle, never a different identity: there is one
/// lookup box, one claim, and one resolver.
///
/// A handle belongs to an ADDRESS, and a merchant profile is a mode on top of it
/// (`merchantId`), which is why the claim lives here rather than on the Merchant
/// row. The binding is an EIP-712 signature, stored verbatim and RE-VERIFIED from
/// the stored signature on every read — there is no stored "verified" boolean. A
/// compromised database can at worst HIDE a handle; it cannot invent a binding,
/// because a binding is a signature and forging one is not a database write.
///
/// The signature is PURPOSE-SCOPED (`purpose`): a signature made to claim a
/// username cannot be replayed to claim a merchant name, or the reverse.
model Handle {
  id             String    @id @default(cuid())
  /// The ONE namespace key — lowercased, `[a-z0-9._-]`, unique across people and
  /// businesses. Computed by `handleOf` in `lib/merchant-name.ts`, which the web
  /// mirrors in `lib/merchant-link.ts`. STORED and UNIQUE because the rule DROPS
  /// characters: `Mama's Grill` and `Mamas Grill` are two distinct NAMES that
  /// reduce to one handle, and only a stored unique column makes
  /// `seti.live/<x>/<handle>` unambiguous about who is paid.
  handle         String    @unique
  /// `person` | `business` — a profile mode on the handle, not an identity.
  kind           String    @default("business")
  /// The username a person typed, or a business's name. Same rule for both.
  name           String
  /// The EIP-712 purpose this binding was signed with: `username` or
  /// `merchant-name`. NULL only for a handle backfilled from a merchant claim
  /// made BEFORE `purpose` existed — its signature was made without the field,
  /// so it is re-verified against the legacy message shape. Every handle claimed
  /// through the API stores a purpose, which is what makes a replay across
  /// purposes impossible.
  purpose        String?
  /// The address the handle is bound to. The authoritative thing for the money
  /// path: a name is only ever a label beside it.
  address        String
  /// The signature, stored verbatim — this is the whole point of the feature.
  claimSignature String?
  /// The `issuedAt` EXACTLY as it appeared in the signed message. Kept as the raw
  /// string, not a DateTime: re-deriving an ISO string from a timestamp can differ
  /// by precision or offset, and a genuine signature would then fail to re-verify.
  claimIssuedAt  String?
  claimNonce     String?
  /// When the backend accepted the claim. Distinct from `claimIssuedAt`.
  claimedAt      DateTime?
  /// The account the handle belongs to. Informational, not a trust anchor: what
  /// makes a claim true is the signature, never who posted it.
  userId         String?
  /// The business profile, when `kind = 'business'`. A person has none.
  merchantId     String?   @unique
  /// Brand-review state: NULL for a normal handle, `pending` for a claim whose
  /// name matched a HELD BRAND (see `lib/held-brands.ts`).
  ///
  /// Deliberately a second, SEPARATE state from verification. `verified` is
  /// recomputed from the signature on every read and is not stored; this column
  /// stores the one thing the signature cannot say — whether a person has looked
  /// yet. A parked row KEEPS its string (the unique index is untouched), but the
  /// resolvers filter it out, so it is not public, has no page and no QR, and a
  /// payer who resolves it gets a name that does not exist. It never reads as
  /// verified while parked. Refusing a parked claim deletes the row, freeing the
  /// string; the reason is recorded in `audit_logs` (`handle.brand.refused`).
  reviewStatus   String?
  /// The held brand the name matched, as spelled on the list — so a parked row
  /// can name, later, what the claimer has to send. Informational.
  reviewBrand    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([userId])
  @@index([name])
  /// The reviewer's queue: every parked claim (`reviewStatus = 'pending'`).
  @@index([reviewStatus])
  @@map("handles")
}

/// A claim that was RELEASED so a proved brand could take the name.
///
/// A brand proving ownership must be able to take a name whatever state it is in
/// — including one already claimed by someone else. The handle string is unique,
/// so the previous claimer's row must go for the new one to exist; this table is
/// where it goes. It is a full copy of the released claim (the signature and all)
/// plus WHY it was released, so a reassignment is never a silent overwrite and the
/// previous holder's record survives.
///
/// Deliberately NOT related by foreign key to `User`/`Merchant`: this is a
/// historical record that must outlive any account or profile deletion, so it
/// keeps the ids as plain strings rather than following them.
model HandleRelease {
  id             String   @id @default(cuid())
  /// The string that was reassigned, e.g. `kfckaribu` — the link a customer had.
  handle         String
  /// The name the RELEASED claim was made under.
  name           String
  /// The kind it was claimed as (`person` | `business`).
  kind           String
  /// The address the released claim pointed at.
  address        String
  claimSignature String?
  claimIssuedAt  String?
  claimNonce     String?
  /// The account that held the released claim, if any.
  userId         String?
  /// The business profile the released claim turned on, if any.
  merchantId     String?
  /// Why it was released — the reason the reviewer recorded.
  reason         String
  /// The address it was reassigned TO (the brand's, proved by signature).
  reassignedTo   String
  createdAt      DateTime @default(now())

  @@index([handle])
  @@map("handle_releases")
}

/// A business PROFILE — the mode a business handle turns on. It carries what a
/// business is (a category, settlement details) and where its money goes
/// (`payoutAddress`), but NOT the claim: the handle, its signature and its
/// uniqueness live in `Handle`, so one string can only ever be one thing.
model Merchant {
  id            String   @id @default(cuid())
  name          String
  category      String?
  bankAccount   String? // encrypted settlement account
  bankName      String?
  bankCurrency  String? // "KES"
  payoutAddress String? // on-chain settlement address
  bridgeRecipientId String? // Bridge recipient ID for fiat payout
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]
  handleEntry  Handle?

  @@map("merchants")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  walletId      String
  type          TransactionType
  status        TransactionStatus @default(pending)
  amount        Decimal           @db.Decimal(24, 8)
  asset         String // "ousd"
  fiatAmount    Decimal?          @db.Decimal(24, 8)
  fiatCurrency  String? // "KES"
  // Merchant fee charged on this payment, in fiatCurrency. Null for
  // consumer-paid types where no merchant fee applies (p2p, top-up).
  feeAmount     Decimal?          @db.Decimal(24, 8)
  // Fee before the max-percent cap was applied. Kept so a capped fee can be
  // reconciled against the published schedule after the fact.
  feeUncappedAmount Decimal?       @db.Decimal(24, 8)
  // True when feeAmount was limited by MERCHANT_FEE_MAX_PERCENT rather than
  // by the published schedule.
  feeCapped     Boolean           @default(false)
  // What the merchant actually receives: fiatAmount - feeAmount. Stored rather
  // than recomputed from a rate that may since have moved.
  //
  // Future-shape, not a payout path: no off-ramp exists in v1 (prd.md §7). The
  // bank/bridge columns on Merchant and the `offramp.*` audit actions are the
  // same category — documented intent, zero call sites.
  merchantNetAmount Decimal?      @db.Decimal(24, 8)
  // FX rate used to derive the fiat figures, and where it came from. Stored so
  // a historical row can always be explained.
  fxRate        Decimal?          @db.Decimal(24, 8)
  fxRateSource  String? // "open.er-api.com", "fallback", etc.
  fxRateAsOf    DateTime?
  merchantId    String?
  counterparty  String? // wallet address, phone, or merchant id
  txHash        String? // on-chain transaction hash — unique PER USER, see below
  blockNumber   BigInt?
  description   String?
  metadata      Json? // qr payload, bridge/stripe refs
  settledAt     DateTime?
  failedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  wallet   Wallet    @relation(fields: [walletId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  // One row per user per on-chain transfer.
  //
  // `txHash` alone used to be unique, which meant one transfer could only ever have
  // ONE ledger row — written by whoever recorded it first, always the sender. A
  // transfer between two Seti accounts is one transaction and two movements of
  // money, and the recipient's side had nowhere to go. Scoping the uniqueness to
  // the user lets both sides exist while still refusing to record the same transfer
  // twice for one account.
  @@unique([txHash, userId])
  @@map("transactions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  /// On-chain transaction hash this event concerns, when there is one.
  ///
  /// Promoted out of `metadata` into a real column: support is handed a hash
  /// and needs every event about it, and the same hash is the only handle that
  /// exists for a payment that was refused before any row was written.
  txHash    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([txHash])
  @@map("audit_logs")
}

enum TransactionType {
  payment
  p2p_send
  p2p_receive
  top_up
  withdrawal
  fee
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  reversed
}

enum WalletStatus {
  active
  frozen
  deprecated
}

enum KycStatus {
  none
  pending
  verified
  rejected
}

enum KycTier {
  tier_0
  tier_1
  tier_2
}

/// Durable indexer progress, one row per chain.
///
/// The cursor lives in Postgres rather than process memory so that a restart
/// resumes where it left off instead of re-scanning, and so that two backend
/// replicas cannot both advance the same cursor independently.
model IndexerCursor {
  /// Chain name, e.g. "tempo-testnet". Part of the primary key: switching
  /// networks gets its own cursor rather than inheriting an incompatible one.
  chain      String   @id
  /// Highest block whose logs have been fully processed.
  lastBlock  BigInt   @default(0)
  /// Identifies the replica currently scanning. Empty when idle.
  lockedBy   String?
  /// When lockedBy last acquired the lock. Used to reclaim a lock abandoned
  /// by a crashed replica.
  lockedAt   DateTime?
  updatedAt  DateTime @updatedAt

  @@map("indexer_cursors")
}

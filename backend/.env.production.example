# =============================================================================
# Seti backend — PRODUCTION configuration template.
#
# Copy to backend/.env.production and fill in every blank:
#   cp backend/.env.production.example backend/.env.production
#
# `backend/.env.production` is gitignored and must never be committed. This file
# is a template only: it contains no real secret, and a copy of it with the
# placeholders left in place will FAIL TO START (which is the point — see below).
#
# The backend parses this at module load, and with NODE_ENV=production it REFUSES
# TO BOOT on an insecure or incomplete configuration, naming the offender(s),
# before it binds a port. There is no override flag. If you see
# [INSECURE_PRODUCTION_CONFIG] in the logs, the message names exactly which
# variable(s) to fix. The refusals are in backend/src/config/env.ts and are
# pinned by `npm run check:env`.
#
# THIS TEMPLATE IS THE LIVE ONE. It serves Tempo mainnet (chain 4217) and settles
# real money. The practice profile differs only in environment variables — chain
# id, RPC, treasury, ALLOW_MAINNET, DEFAULT_NETWORK — which is what makes a
# Moderato dev machine possible from the same code.
# =============================================================================

# DATABASE_URL is supplied by docker-compose.yml (service name `postgres`, or
# SETI_DATABASE_URL from ./.env). Leave it out here — an unused value in this
# file is one more thing to get wrong. On the systemd path there is no compose
# to fill it in, so set it there:
#   DATABASE_URL=postgresql://seti:<password>@127.0.0.1:5432/seti?schema=public

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# --- Secrets: generate each with `openssl rand -base64 32` -------------------
#
# Refused in production if left at the example placeholder. Public, so not a
# secret.
JWT_SECRET=change-me-in-production

# Refused in production if unset or shorter than 16 characters. MUST be the SAME
# value on every backend instance: a quote minted by one is verified by another
# only if they share the key.
QUOTE_SIGNING_SECRET=

# Used to verify Privy access tokens. Refused in production if either is unset —
# with no client, every authenticated request throws and the API serves nobody.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Same Privy app as the web build's NEXT_PUBLIC_PRIVY_APP_ID — one app, not two.
# The web app signs people in with an emailed ONE-TIME CODE (Privy has no
# magic-link login in its web SDK), and the send is refused with `invalid_origin`
# until the origin the app is actually served from is allowlisted in the Privy
# dashboard under Settings → Domains. Do that before the first sign-in attempt,
# not after.

# --- Auth --------------------------------------------------------------------
# A production process REFUSES TO START with DEV_BYPASS_AUTH=true. Leave it false.
DEV_BYPASS_AUTH=false

# --- Chain (MAINNET — this deployment serves live) ---------------------------
# 4217 = Tempo mainnet. 42431 = Moderato (practice). The chain id is the primary
# lever: it names the chain this process signs for and reads.
TEMPO_CHAIN_ID=4217
TEMPO_RPC_URL=https://rpc.tempo.xyz
# Per-network override, read before TEMPO_RPC_URL for the chain it names:
# TEMPO_MAINNET_RPC_URL=
# ALCHEMY_API_KEY=
TEMPO_TOKEN_PATHUSD=0x20c0000000000000000000000000000000000000
TEMPO_TOKEN_OUSD=0x20c0000000000000000000006a37da5c996874be
TEMPO_ASSET=ousd

# Where the fee leg of every batched payment goes, and it is PER NETWORK: the
# mainnet treasury is a different destination from the practice one, and
# `resolveTreasury` in src/config/networks.ts reads THESE, not the older single
# SETI_TREASURY_ADDRESS still shown in the practice template. Must be 20-byte hex
# and not the zero address (a burn destination) — both are refused at boot.
TEMPO_MAINNET_TREASURY_ADDRESS=
TEMPO_TESTNET_TREASURY_ADDRESS=0x48cb25f9d82aF721e71437feAfb295da627BA475

# REQUIRED for mainnet to be SERVED at all: without exactly `true`, this is a
# boot refusal. Nothing else in the process can opt into real money.
ALLOW_MAINNET=true
# Must be 0 on mainnet: a non-zero lookback would scan live-chain history on
# first pass, and is refused there.
INDEXER_BOOTSTRAP_LOOKBACK=0

# The network this DEPLOYMENT defaults to. The live deployment sets `mainnet`,
# and cannot without ALLOW_MAINNET=true above. An unrecognised value is a boot
# refusal.
DEFAULT_NETWORK=mainnet

# --- The live gate -----------------------------------------------------------
# The hash of ONE real mainnet transaction that carried BOTH legs: the principal
# to the recipient, and the fee to TEMPO_MAINNET_TREASURY_ADDRESS. Live is
# refused while this is empty.
#
# Read what this is and is not, before trusting it: today the gate checks that
# this string is PRESENT, nothing reads the transaction. A typo would open Live.
# Making it verify the receipt is task 4 of the mainnet agenda; the flip sequence
# is in docs/internal/mainnet-flip.md.
MAINNET_BATCH_PROOF_TX=

# --- Cross-origin policy -----------------------------------------------------
# PRODUCTION REFUSES TO START with this unset. It IS the browser policy: list the
# exact origin(s) the web app is served from. Set it BEFORE the front end is
# exercised — an empty list boots healthy and then 403s every call as an opaque
# CORS error. Comma-separated, no trailing slash.
#   e.g. https://app.seti.example,https://seti-web.pages.dev
CORS_ALLOWED_ORIGINS=

# --- Fee routing -------------------------------------------------------------
# batch: the customer signs ONE atomic transaction carrying principal to the
# merchant and the 2% to SETI_TREASURY_ADDRESS. Both legs are required on-chain.
FEE_ROUTING_MODE=batch

# --- Indexer -----------------------------------------------------------------
# The API process must not run the loop when a dedicated indexer service does.
# docker-compose.yml sets this to "false" for the api service and the worker
# (dist/worker.js) starts the loop unconditionally. On the systemd path this line
# is what keeps the loop in seti-indexer.service only.
INDEXER_ENABLED=true

# --- FX quotes ---------------------------------------------------------------
QUOTE_TTL_SECONDS=60

# --- Fee schedule (flat 2%, no floor, no cap) --------------------------------
MERCHANT_FEE_PERCENT=2
MERCHANT_FEE_MIN_KES=0
MERCHANT_FEE_MAX_PERCENT=0

# --- Stuck-transaction sweep -------------------------------------------------
STUCK_TX_AGE_MINUTES=10
STUCK_TX_SWEEP_LIMIT=25

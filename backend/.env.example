# =============================================================================
# Seti backend environment
#
# Copy to `.env` for local development:  cp .env.example .env
#
# PRODUCTION WILL REFUSE TO BOOT on an insecure configuration. With
# NODE_ENV=production the process exits non-zero, naming the offending
# variable(s), before it binds a port — there is no override flag:
#   * DEV_BYPASS_AUTH=true        — the auth bypass would serve the API to anyone
#   * QUOTE_SIGNING_SECRET unset   — or under 16 chars; every process would mint
#                                    its own key and every frozen quote would die
#                                    on restart or across instances
#   * JWT_SECRET left as the example placeholder "change-me-in-production"
#   * PRIVY_APP_ID or PRIVY_APP_SECRET unset — with no client, no access token
#                                    can be verified, so the API serves nobody
#   * CORS_ALLOWED_ORIGINS unset   — an empty allow-list denies every browser
#                                    origin, so the web app 403s on every call
#   * TEMPO_CHAIN_ID unset, mainnet (4217) without ALLOW_MAINNET=true, or a
#     non-zero INDEXER_BOOTSTRAP_LOOKBACK on mainnet
# The refusals are pinned by `npm run check:env` (part of `npm run verify`); the
# operational rules are in docs/operations.md.
# =============================================================================

# Postgres connection
DATABASE_URL="postgresql://seti:seti@localhost:5433/seti?schema=public"

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS allow-list, comma-separated. Only consulted outside development (in
# development any origin is reflected so localhost and tunnels work unconfigured).
# In production this list IS the cross-origin policy: PRODUCTION REFUSES TO START
# with it unset, because an empty list denies every browser origin. Example:
#   CORS_ALLOWED_ORIGINS=https://app.seti.example,https://random-words.trycloudflare.com
CORS_ALLOWED_ORIGINS=

# Privy / Tempo Accounts (embedded wallets)
# Both are optional in development (verification throws until set) but REQUIRED in
# production: without them no access token can be verified and the API serves
# nobody, so the process refuses to start.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Development-only auth bypass.
#
# When "true" AND NODE_ENV=development, an unauthenticated request is attached to
# a single shared dev user. It is never an override: a request carrying a real
# Privy bearer token is still verified for real.
#
# In production this is not merely ignored — the process REFUSES TO START with
# DEV_BYPASS_AUTH=true (see the header). A deployment must fail loudly rather
# than boot an API that answers anyone. Leave it "false".
DEV_BYPASS_AUTH=false

# Tempo network
# 4217 = mainnet, 42431 = testnet (Moderato)
TEMPO_CHAIN_ID=42431

# RPC provider. Set ALCHEMY_API_KEY to use Alchemy, or set TEMPO_RPC_URL to any RPC.
#
# Precedence (most specific first): TEMPO_<NETWORK>_RPC_URL below → TEMPO_RPC_URL,
# but only for the chain TEMPO_CHAIN_ID names → the Alchemy endpoint, if a key is set.
#
# Alchemy's FREE tier refuses an eth_getLogs wider than 10 blocks, and the indexer
# scans 2000-block windows (MAX_RANGE in src/services/indexer-cursor.ts). An Alchemy
# key alone therefore cannot index a live chain — it fails every pass closed with
# "Under the Free tier plan, you can make eth_getLogs requests with up to a 10 block
# range". Pin the per-network variables at the chain's own RPC instead.
ALCHEMY_API_KEY=
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Per-network endpoints — pin ONE chain without disturbing the other.
TEMPO_MAINNET_RPC_URL=https://rpc.tempo.xyz
TEMPO_TESTNET_RPC_URL=https://rpc.moderato.tempo.xyz

# Tempo token contracts (must match TEMPO_CHAIN_ID)
#
# v1 supports pathUSD and OUSD only. These two are verified as deployed on
# BOTH Tempo mainnet (4217) and Moderato testnet (42431), decimals 6.
# Do not add an asset without confirming eth_getCode is non-empty on both
# chains — a transfer to an address with no code can succeed as a silent no-op.
TEMPO_TOKEN_PATHUSD=0x20c0000000000000000000000000000000000000
TEMPO_TOKEN_OUSD=0x20c0000000000000000000006a37da5c996874be

# The primary asset the money path spends: the asset a payment or send is signed
# in, and the one the estimate and balance reservation are measured in.
#
# One setting, read once (`config/networks.ts` re-exports it as PRIMARY_ASSET) and
# consumed by the route schemas, the balance lookup and `prove:batch` — a second
# hardcode is how the asset stays wrong. `ousd` or `pathusd`; defaults to `ousd`
# (Seti's decided money path). Must match the web app's NEXT_PUBLIC_TEMPO_ASSET.
TEMPO_ASSET=ousd

# Address that collects the platform fee: the fee leg of every batched payment
# and send goes here. Must be a 20-byte hex address, and it must NOT be the zero
# address — that is a burn destination, so the fee would be destroyed while the
# ledger recorded it as collected. The backend refuses to boot with 0x000…000.
#
# This is the real Seti treasury (it is public — the app's footer shows it).
SETI_TREASURY_ADDRESS=0x48cb25f9d82aF721e71437feAfb295da627BA475

# Mainnet safety gate. Set to "true" only when intentionally operating on mainnet.
ALLOW_MAINNET=false

# Which network this DEPLOYMENT defaults to: `mainnet` | `testnet`.
#
# Optional, and the CODE default is `testnet` — a dev box that sets nothing cannot
# default to real money (AGENTS.md: never default to mainnet in development). A
# deployment that IS the live one sets `DEFAULT_NETWORK=mainnet`; mainnet still
# needs ALLOW_MAINNET=true on top, and a value that is neither `mainnet` nor
# `testnet` is a boot refusal (pinned by `npm run check:env`).
#
# It is only the FALLBACK for the served network when no TEMPO_CHAIN_ID names
# one; an explicit chain id always wins. It is NOT what an omitted per-row
# network resolves to — that is always the network the deployment SERVES.
DEFAULT_NETWORK=testnet

# =============================================================================
# PER-NETWORK CONFIGURATION
#
# Chain id, RPC, token addresses, treasury and the check anchors are PER NETWORK:
# `config/networks.ts` builds both, and the deployment SERVES one of them
# (selected by TEMPO_CHAIN_ID + ALLOW_MAINNET above). The shared values further
# up are the fallback for whichever network is served; each variable below
# overrides ONE network without touching the other.
#
# Every one is optional. Leave them unset and the shared values apply to both.
# =============================================================================
# TEMPO_TESTNET_RPC_URL=
# TEMPO_MAINNET_RPC_URL=
# TEMPO_TESTNET_TREASURY_ADDRESS=
# TEMPO_MAINNET_TREASURY_ADDRESS=
# TEMPO_TESTNET_TOKEN_PATHUSD=
# TEMPO_TESTNET_TOKEN_OUSD=
# TEMPO_MAINNET_TOKEN_PATHUSD=
# TEMPO_MAINNET_TOKEN_OUSD=
# TEMPO_TESTNET_PAYOUT_ANCHOR_TX=
# TEMPO_MAINNET_PAYOUT_ANCHOR_TX=
# TEMPO_TESTNET_SEND_ANCHOR_TX=
# TEMPO_MAINNET_SEND_ANCHOR_TX=
# TEMPO_TESTNET_QUOTE_ANCHOR_TX=
# TEMPO_MAINNET_QUOTE_ANCHOR_TX=

# THE mainnet-readiness gate: a real mainnet batch receipt (chain 4217) whose ONE
# transaction carries both legs — principal to the recipient, fee to the treasury.
#
# Until this is set (AND ALLOW_MAINNET=true AND the deployment serves 4217), the
# account's Live side is REFUSED with a stated reason: `POST /account/network`
# answers `mainnet-not-ready`, and Profile shows the reason instead of a bare
# disabled control. It is the rule docs/internal/mainnet-flip.md already writes —
# a mainnet batch proof must land before any real money moves — made executable.
#
# Setting it does not enable mainnet on its own; it only lifts the PRODUCT gate.
# MAINNET_BATCH_PROOF_TX=

# Blocks to look back on first run when no indexer cursor exists.
# Keep this at 0 in production: a non-zero lookback writes pre-existing chain
# history as new transactions. On mainnet, seed the cursor to the chain head
# (INSERT INTO indexer_cursors (chain, "lastBlock", "updatedAt") VALUES
# ('tempo-mainnet', <head>, NOW())) instead.
INDEXER_BOOTSTRAP_LOOKBACK=0

# Merchant fee schedule. Consumers pay 0%.
#
# v1 settles non-custodially — the customer's stablecoins go straight to the
# merchant's own wallet, with no fiat off-ramp and no per-payout cost. So the
# fee is a flat percentage with no floor, which keeps the published "2%" true at
# every ticket size.
#
# The floor and cap are retained for when a real off-ramp lands: a flat fee on
# a KES 50 payment would not cover a per-payout charge, and the cap stops a
# floor from swallowing small payments whole.
MERCHANT_FEE_PERCENT=2
MERCHANT_FEE_MIN_KES=0
MERCHANT_FEE_MAX_PERCENT=0

# How the fee reaches Seti.
#
# inside-transfer (default): the customer signs ONE transfer of principal + fee
#   to the merchant. The fee is computed, recorded and audited, but the merchant
#   receives the whole gross, so Seti collects nothing. This is the historical
#   behaviour.
# batch: the customer signs an atomic batch of two transfers — principal to the
#   merchant, fee to SETI_TREASURY_ADDRESS. recordPayment then requires BOTH
#   Transfer logs in the one receipt and fails closed if either is missing.
#
# Both modes are implemented; only `batch` collects the fee. `inside-transfer`
# pays the whole gross to the recipient (a fee Seti forgoes, and a fee paid TO the
# recipient on a P2P send, which is why sends are refused there).
#
# Before mainnet: prove a batched transaction actually lands on Moderato. The
# guards are covered by `FEE_ROUTING_MODE=batch npm run check:fee-batch` and
# `npm run check:send`; the success path needs a real signature.
FEE_ROUTING_MODE=batch

# Check-suite anchors (dev/CI only — leave unset to use the pinned default)
#
# The check suites that reconcile against a real on-chain receipt anchor on a
# KNOWN transaction, read BY HASH. A receipt is immutable, so the verdict depends
# on the code rather than on what happened to be on chain this hour — a quiet
# chain cannot turn the verify gate red for the wrong reason. Override any of
# these to point a suite at a fresh receipt (e.g. after `npm run prove:batch`).
# If the pinned receipt cannot be found the suite FAILS LOUDLY, naming the hash
# and the network, rather than skipping quietly.
#
# PAYOUT_ANCHOR_TX — check:payout's batched OUSD receipt. Default:
#   0x8e9c2ba14b14e046bdec1974eb119c4b7137a437ddd538d22038303c5b4aa78d
#   (block 39315983: 0.5 OUSD to a recipient + 0.01 OUSD to the treasury + gas).
#   Set it to `search` to run the old live 60k-block window scan instead — that
#   live path is the only one that can find nothing on a quiet chain.
# SEND_ANCHOR_TX — no longer read by `check:send`, which pins per NETWORK (a
#   receipt is a fact about one chain):
#     TEMPO_TESTNET_SEND_ANCHOR_TX — default:
#       0xe58f82dfd016ad6d1823dde4183d386bf0c62d59cf4de6706f45b9cab39186f0
#       (0.5 OUSD to a recipient + 0.01 fee to the treasury + gas).
#     TEMPO_MAINNET_SEND_ANCHOR_TX — unset until a real mainnet batch exists.
#       `npm run prove:batch -- --network=mainnet --confirm-real-money` prints the
#       exact line to pin. With no mainnet anchor pinned, `check:send` SKIPS
#       loudly on a Live deployment instead of reading the other chain's receipt.
#   The suite DERIVES its fixture from whichever receipt is pinned (signer,
#   recipient, principal and asset all come off the receipt), so a new anchor
#   needs no code change.
# QUOTE_ANCHOR_TX — check:quote's batched pathUSD receipt. Defaults to the same
#   receipt check:send uses.
PAYOUT_ANCHOR_TX=
QUOTE_ANCHOR_TX=

# FX rate quotes (freeze the rate at quote time).
#
# A preview signs the rate it priced with and returns it as a `quoteId`. The
# record path — POST /transactions/pay and POST /transactions/send — writes every
# fiat figure from the rate inside that token, never from a freshly-read live
# rate, so the figure the customer was shown is the figure written to the ledger.
# A missing, forged, expired or foreign quote is refused; there is deliberately
# no live-rate fallback.
#
# QUOTE_TTL_SECONDS bounds how long a quote may be redeemed. 60s spans the gap
# between a preview and the record that follows a wallet signature. It is not
# surfaced as a countdown in the UI: the promise is "the figure you saw is the
# figure we record", not "your rate is locked for a minute".
QUOTE_TTL_SECONDS=60
#
# HMAC key for those quotes. REQUIRED in production, and MUST be identical on
# every backend instance — a quote minted by one instance is only readable by
# another that shares the key. When unset, the process mints a random key and
# warns once: quotes stay unforgeable, but they do not survive a restart and are
# not shared across instances.
#
# In production this dev fallback is not available: the process REFUSES TO BOOT
# when QUOTE_SIGNING_SECRET is unset or shorter than 16 characters. A paper-thin
# key is treated as unset because the point of the variable is a shared,
# unpredictable one. Generate one (e.g. `openssl rand -base64 32`) and set the
# SAME value on every instance.
QUOTE_SIGNING_SECRET=

# Bridge / Stripe (off-ramp)
BRIDGE_API_KEY=
STRIPE_SECRET_KEY=

# Charge webhooks (#131, #156)
#
# The DEPLOYMENT-WIDE HMAC key, used for a charge whose recipient has no merchant
# app behind it:
#
#   X-Seti-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of "<t>.<body>">
#
# A charge paid to an address a MERCHANT APP is bound to is signed with THAT app's
# own secret instead (`seti.merchant_apps`, sealed under SETI_SECRET_BOX_KEY), so
# this value is the fallback rather than the whole story. Either way a receiver
# verifies with this same value, so it must be strong and IDENTICAL on every backend
# instance — a per-instance value would make a webhook verify on one box and fail on
# the next. Generate one (`openssl rand -base64 32`) and treat it as a shared secret.
#
# UNLIKE QUOTE_SIGNING_SECRET, an unset value does NOT stop the process: the charge
# API is useful without notification, and refusing to boot would take the whole
# receive path down for a webhook it does not owe. What happens instead is visible:
# no webhook is sent, each delivery row is recorded `failed` with
# lastError="webhook-signing-secret-unset" (the recipient reads that in their own
# delivery log), and the server logs one warning.
SETI_WEBHOOK_SECRET=

# The key that seals merchant webhook secrets at rest (#156)
#
# A merchant app's webhook secret is an HMAC KEY, not a password: signing a delivery
# needs the key itself, so it cannot be hashed and is stored with AES-256-GCM under
# THIS value instead. A database dump without it is a column of ciphertext.
#
# Generate 32 bytes: `openssl rand -base64 32`. Set the SAME value on every backend
# instance, because any box may deliver any merchant's webhook.
#
# Optional in the schema for the same reason SETI_WEBHOOK_SECRET is: this credential
# store gates ONE feature (merchant apps), and a boot refusal would take the whole
# API down for it. What happens instead is bounded and named: creating or rotating an
# app is refused with `secret-box-unset` BEFORE any row is written, so nothing is ever
# stored unopenable. Outside production a key is derived from JWT_SECRET (with one
# warning) so a laptop works unconfigured, and NEVER in production.
SETI_SECRET_BOX_KEY=

# The PREVIOUS secret-box key, during a rotation of the key itself (#156)
#
# Decrypt-only: nothing is ever sealed with it. Set it to the outgoing value, deploy,
# rotate each app's own secret (or let it happen at the next rotation), then clear it.
# See docs/operations.md §1.1.
SETI_SECRET_BOX_KEY_PREVIOUS=

# The origin a charge's `pageUrl` points at — the site a human opens for
# `seti.live/pay/<id>`. Config rather than the request's Host header: a charge
# created by `curl` on a laptop must come back with a URL that opens on the real
# site. Defaults to https://seti.live; set it to your dev origin (e.g.
# http://localhost:3000) when working locally.
SETI_PAGE_ORIGIN=

# JWT (auth)
#
# The value below is the documented example placeholder and is NOT a secret. A
# production process REFUSES TO BOOT while JWT_SECRET is still exactly this
# string. Set a real secret in production (`openssl rand -base64 32`).
JWT_SECRET=change-me-in-production

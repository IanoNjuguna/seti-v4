    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
